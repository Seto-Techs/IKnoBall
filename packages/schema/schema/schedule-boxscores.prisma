model ScheduleBoxScoreSummary {
  id                String   @id @default(uuid())
  scheduleGameId    String   @unique
  gameCode          String
  gameStatus        Int
  gameStatusText    String
  period            Int
  gameClock         String?
  gameTimeUTC       DateTime?
  gameEt            DateTime?
  duration          String?
  attendance        Int?
  sellout           Int?
  seriesGameNumber  String?
  gameLabel         String?
  gameSubLabel      String?
  seriesText        String?
  ifNecessary       Boolean
  isNeutral         Boolean

  arenaId           Int?
  arenaName         String?
  arenaCity         String?
  arenaState        String?
  arenaCountry      String?
  arenaTimezone     String?
  arenaStreet       String?
  arenaPostalCode   String?

  homeTeamId        Int
  homeScore         Int?
  homeInBonus       String?
  homeTimeouts      Int?
  homeSeed          Int?
  homePeriods       Json?
  homePlayers       Json?
  homeInactives     Json?

  awayTeamId        Int
  awayTeamName      String?
  awayTeamCity      String?
  awayTeamTricode   String?
  awayTeamSlug      String?
  awayTeamWins      Int?
  awayTeamLosses    Int?
  awayScore         Int?
  awayInBonus       String?
  awayTimeouts      Int?
  awaySeed          Int?
  awayStatistics    Json?
  awayPeriods       Json?
  awayPlayers       Json?
  awayInactives     Json?

  lastFiveMeetings  Json?
  pregameCharts     Json?
  postgameCharts    Json?

  scheduleGame      ScheduleGame @relation(fields: [scheduleGameId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("schedule_boxscore_summaries")
}

model ScheduleBoxScoreTeam {
  id              String           @id @default(uuid())
  scheduleGameId  String
  teamExternalId  Int
  side            ScheduleTeamSide

  minutes         String?
  fgMade          Int?
  fgAttempted     Int?
  fgPct           Float?
  fg3Made         Int?
  fg3Attempted    Int?
  fg3Pct          Float?
  ftMade          Int?
  ftAttempted     Int?
  ftPct           Float?
  oreb            Int?
  dreb            Int?
  reb             Int?
  ast             Int?
  stl             Int?
  blk             Int?
  tov             Int?
  pf              Int?
  pts             Int?
  plusMinus       Float?

  scheduleGame    ScheduleGame     @relation(fields: [scheduleGameId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([scheduleGameId, side])
  @@index([scheduleGameId])
  @@index([teamExternalId])
  @@map("schedule_boxscore_teams")
}

model ScheduleBoxScorePlayer {
  id               String        @id @default(uuid())
  scheduleGameId   String
  playerId         String
  playerExternalId String
  teamExternalId   Int

  minutes          String?
  fgMade           Int?
  fgAttempted      Int?
  fgPct            Float?
  fg3Made          Int?
  fg3Attempted     Int?
  fg3Pct           Float?
  ftMade           Int?
  ftAttempted      Int?
  ftPct            Float?
  oreb             Int?
  dreb             Int?
  reb              Int?
  ast              Int?
  stl              Int?
  blk              Int?
  tov              Int?
  pf               Int?
  pts              Int?
  plusMinus        Float?

  scheduleGame     ScheduleGame  @relation(fields: [scheduleGameId], references: [id])
  player           Player        @relation(fields: [playerId], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([scheduleGameId, playerExternalId])
  @@index([scheduleGameId])
  @@index([playerId])
  @@index([playerExternalId])
  @@map("schedule_boxscore_players")
}
