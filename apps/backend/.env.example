# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/iknoball"
DATABASE_URL_SHADOW="postgresql://USER:PASSWORD@localhost:5432/iknoball_shadow"

# Better Auth
# Must be the public backend origin; Better Auth mounts routes at /auth.
BETTER_AUTH_URL="http://localhost:3000"
PORT=3000

# Logging (Winston). JSON output when NODE_ENV=production, pretty console otherwise.
NODE_ENV="development"
LOG_LEVEL="debug"
FRONTEND_URL="http://localhost:5173"

# Discord OAuth. In Discord Developer Portal add this Redirect URI exactly:
# http://localhost:3000/auth/callback/discord
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# Redis
REDIS_URL="redis://:PASSWORD@localhost:6379/0"
REDIS_LOGGING_URL="redis://:PASSWORD@localhost:6379/1"
ACTIVITY_LOG_KEY="queue:iknoball"

# S3
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="ap-southeast-3"
AWS_BUCKET="iknoball"
AWS_BASE_URL="https://iknoball.s3.ap-southeast-3.amazonaws.com"

# Email worker queue. Better Auth verification and password-reset emails are
# rendered here, then pushed to this Redis list for the existing email worker.
EMAIL_QUEUE_REDIS_URL="redis://:PASSWORD@localhost:6379/2"
EMAIL_QUEUE_KEY="queue:iknoball-email"
EMAIL_INTERNAL_TOKEN="CHANGE_ME"
EMAIL_FROM_NAME="IKnoBall"
EMAIL_FROM_ADDRESS_MAP='{"verify":"no-reply@example.com","reset":"no-reply@example.com","loginOtp":"no-reply@example.com","reminder":"no-reply@example.com"}'

# Direct SMTP is retained for EmailService.send(); Better Auth does not use it.
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER="smtp-username"
EMAIL_SMTP_PASS="CHANGE_ME"
EMAIL_FROM="IKnoBall <no-reply@example.com>"
