# The Discord application that owns the bot and the Activity.
VITE_DISCORD_CLIENT_ID="1531941991875743744"

# API base. A *path*, not an origin, in a production build: the activity is
# served from `<app id>.discordsays.com`, so `/be/api/...` stays same-origin and
# reaches the API through the portal's `/be` URL mapping. Same-origin means no
# CORS and no ACTIVITY_URL. Leave it unset in development: the Vite proxy serves
# /api same-origin. Only a cross-origin API would need an origin here.
# VITE_API_URL="/be"
