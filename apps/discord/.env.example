# Discord bot environment. Copy to `.env` in this directory.
#
# `main.ts` loads, in order: ../../.env, ../.env, then ./.env (each overriding the
# last), so a root-level .env is picked up too. The bot shares the backend's
# PostgreSQL and Redis, so DATABASE_URL and REDIS_URL come from the same place
# they do for the worker.

# Bot token from the Discord Developer Portal (Bot → Reset Token). Required:
# the process exits non-zero at boot when it is missing or invalid.
DISCORD_TOKEN="YOUR_BOT_TOKEN"

# Origin only — no path. The backend sets a global `api` prefix, so the client
# appends `/api/internal/...` itself. Inside the compose stack this is the API's
# service name, which is why /internal never has to be reachable from the internet.
IKNOBALL_API_URL="http://localhost:3000"

# Shared secret for the bot → API `/internal/*` calls. Must match the backend's
# INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN="CHANGE_ME"

# Kill switch (DISC-14). `false` stops posting and locking while leaving the bot
# connected; anything else, including unset, runs normally.
DISCORD_ENABLED="true"

# PostgreSQL (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/iknoball"

# Redis (required) — same instance the worker and backend use.
REDIS_URL="redis://:PASSWORD@localhost:6379/0"
