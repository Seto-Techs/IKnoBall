{
  "name": "iknoball-worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint .",
    "start": "node dist/main.js",
    "start:dev": "node --enable-source-maps --loader ts-node/esm src/main.ts",
    "dev": "bun run start:dev",
    "run:sync": "node dist/run-sync.js",
    "sync:schedule": "node dist/run-schedule-today.js",
    "sync:schedule:all": "node dist/run-schedule-all.js",
    "sync:schedule:force": "node dist/run-schedule-all-force.js",
    "sync:boxscore": "node dist/run-boxscore.js"
  },
  "dependencies": {
    "@iknoball/database": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/schedule": "^5.0.0",
    "bullmq": "^5.58.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
