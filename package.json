{
  "name": "iknoball",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "bun --filter '@iknoball/database' run generate",
    "migrate": "bun --filter '@iknoball/database' run migrate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "backend": "turbo run dev --filter=backend",
    "frontend": "turbo run dev --filter=frontend",
    "worker": "turbo run dev --filter=iknoball-worker",
    "backend:build": "turbo run build --filter=backend",
    "frontend:build": "turbo run build --filter=frontend",
    "worker:build": "turbo run build --filter=iknoball-worker",
    "backend:test": "turbo run test --filter=backend",
    "backend:lint": "turbo run lint --filter=backend",
    "frontend:lint": "turbo run lint --filter=frontend",
    "docker:backend": "docker build -f apps/backend/Dockerfile .",
    "docker:frontend": "docker build -f apps/frontend/Dockerfile .",
    "docker:worker": "docker build -f apps/worker/Dockerfile .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.8.10"
  },
  "packageManager": "bun@1.3.14"
}
