model PlayerSeasonStats {
  id             String   @id @default(uuid())
  playerId       String
  season         String
  gp             Int?
  wins           Int?
  losses         Int?
  fgPct          Float?
  fg3Pct         Float?
  ftPct          Float?
  ptsTotal       Float?
  rebTotal       Float?
  astTotal       Float?
  ptsPerGame     Float?
  rebPerGame     Float?
  astPerGame     Float?
  statsTimeframe String?

  player         Player   @relation(fields: [playerId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([playerId, season, statsTimeframe])
  @@index([playerId])
  @@map("player_season_stats")
}
