model ScheduleDay {
  id          String          @id @default(uuid())
  gameDate    DateTime        @db.Date
  seasonYear  String
  leagueId    String
  metaVersion Int
  metaRequest String
  metaTime    DateTime
  hash        String

  games       ScheduleGame[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([gameDate, seasonYear, leagueId])
  @@index([gameDate])
  @@map("schedule_days")
}

model ScheduleGame {
  id               String                 @id @default(uuid())
  scheduleDayId    String
  gameId           String                 @unique
  gameDate         DateTime               @db.Date
  gameCode         String
  gameStatus       Int
  gameStatusText   String
  gameSequence     Int
  gameDateEst      DateTime?
  gameTimeEst      DateTime?
  gameDateTimeEst  DateTime?
  gameDateUTC      DateTime?
  gameTimeUTC      DateTime?
  gameDateTimeUTC  DateTime?
  awayTeamTime     DateTime?
  homeTeamTime     DateTime?
  day              String?
  monthNum         Int?
  weekNumber       Int?
  weekName         String?
  ifNecessary      String?
  seriesGameNumber String?
  gameLabel        String?
  gameSubLabel     String?
  seriesText       String?
  arenaName        String?
  arenaState       String?
  arenaCity        String?
  postponedStatus  String?
  branchLink       String?
  gameSubtype      String?
  isNeutral        Boolean

  homeTeamId       Int?
  homeTeamName     String?
  homeTeamCity     String?
  homeTeamTricode  String?
  homeTeamSlug     String?
  homeTeamWins     Int?
  homeTeamLosses   Int?
  homeTeamScore    Int?
  homeTeamSeed     Int?

  awayTeamId       Int?
  awayTeamName     String?
  awayTeamCity     String?
  awayTeamTricode  String?
  awayTeamSlug     String?
  awayTeamWins     Int?
  awayTeamLosses   Int?
  awayTeamScore    Int?
  awayTeamSeed     Int?

  scheduleDay      ScheduleDay            @relation(fields: [scheduleDayId], references: [id])
  pointsLeaders    SchedulePointsLeader[]
  boxscoreSummary  ScheduleBoxScoreSummary?
  boxscoreTeams    ScheduleBoxScoreTeam[]
  boxscorePlayers  ScheduleBoxScorePlayer[]

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([gameDate])
  @@index([scheduleDayId])
  @@map("schedule_games")
}

model SchedulePointsLeader {
  id              String        @id @default(uuid())
  scheduleGameId  String
  personId        Int?
  firstName       String?
  lastName        String?
  teamId          Int?
  teamCity        String?
  teamName        String?
  teamTricode     String?
  points          Float?

  scheduleGame    ScheduleGame @relation(fields: [scheduleGameId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scheduleGameId])
  @@map("schedule_points_leaders")
}
