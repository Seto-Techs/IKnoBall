#!/usr/bin/env bash
set -euo pipefail

# Prepare a fresh IKnoBall orb: workspace dependencies, built shared packages, a
# local env file, and database migrations. Idempotent, so it is safe to re-run
# on a stale snapshot.
#
# Postgres and Redis come from Amp project environment variables (DATABASE_URL,
# REDIS_*), so nothing here starts a local server. Long-running dev servers are
# declared in .amp/services.yaml and started with `amp orb services ensure`.

cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }

step "Installing dependencies"
# `--ignore-scripts` matches the repository's Dockerfiles. It also skips the
# root `prepare` script, which runs `lefthook install`; lefthook aborts in orbs
# because Amp sets a global core.hooksPath, and git hooks are pointless here.
bun install --frozen-lockfile --ignore-scripts

step "Building shared workspace packages"
# apps/* import @iknoball/* from their built dist/, which is gitignored, so a
# fresh checkout cannot run until these exist.
bunx turbo run build \
  --filter='@iknoball/database' \
  --filter='@iknoball/schema' \
  --filter='@iknoball/predictions'

step "Preparing local .env"
if [ -f .env ]; then
  note ".env already exists; leaving it untouched"
else
  # Only orb-local values belong here. Everything else (DATABASE_URL, REDIS_*,
  # BETTER_AUTH_URL, FRONTEND_URL, AWS_*, DISCORD_*) comes from project-scoped
  # env vars and secrets, which take precedence over this file.
  cat >.env <<EOF
# Generated by .agents/setup for this orb. Gitignored.
NODE_ENV="development"
LOG_LEVEL="debug"

# Not stored as a project secret, so each orb generates its own. Sessions are
# therefore not portable between orbs.
BETTER_AUTH_SECRET="$(openssl rand -base64 32)"
EOF
  note "wrote .env with a fresh BETTER_AUTH_SECRET"
fi

step "Applying database migrations"
if [ -n "${DATABASE_URL:-}" ]; then
  # Non-fatal: a transient network blip against the remote dev database should
  # not stop the orb from being snapshotted. The app cannot serve requests
  # against an unmigrated database, so run `bun run migrate` by hand if this warns.
  if ! bun run --filter '@iknoball/database' migrate; then
    printf '\nWARNING: migrations did not apply. Run `bun run migrate` before using the app.\n' >&2
  fi
else
  note "DATABASE_URL is unset; skipping migrations"
fi

step "Setup complete"
note "Start the dev servers with: amp orb services ensure"
if [ -n "${PORTAL_HOSTNAME:-}" ]; then
  note "Stable portal URL: https://${PORTAL_HOSTNAME}/"
else
  note "Set the PORTAL_HOSTNAME project env var for a portal URL that survives orb changes"
fi
